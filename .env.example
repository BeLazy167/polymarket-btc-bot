# Wallet private key that signs Polymarket CLOB orders (required for live mode).
POLYMARKET_PRIVATE_KEY=0x...

# Polymarket API credentials from `bun run setup` (required for live mode).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket profile address, needed for magic/email wallets (optional).
POLYMARKET_FUNDER_ADDRESS=0x...

# Telegram alerts and pause/resume commands (optional; needs a telegram: block in config.yaml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pino log level: debug, info, warn, error (default info).
LOG_LEVEL=info
